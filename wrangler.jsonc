{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "princess-local",
    "main": "src/worker/index.ts",
    "compatibility_date": "2026-05-09",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 0.05
        }
    },
    "vars": {
        "BOT_ENVIRONMENT": "local",
        "ENABLE_SCHEDULED_CLEANUP": "true",
        "AUTHOR_TWITTER_LINK": "https://twitter.com/giraffender",
        "WISHLIST_TG_URL": "https://t.me/wishlist_ua_bot",
        "CHATGPT_GITHUB_REPO_URL": "https://github.com/serhii-chernenko/chatgpt-telegram-bot",
        "TG_CHANNEL": "https://t.me/serhii_chernenko",
        "TG_GROUP": "https://t.me/serhii_chernenko_chat",
        "YT_CHANNEL": "https://youtube.com/@serhii.chernenko",
        "MAIL": "contact@chernenko.digital"
    },
    "secrets": {
        "required": [
            "BOT_TOKEN",
            "TELEGRAM_WEBHOOK_SECRET",
            "TELEGRAM_WEBHOOK_PATH"
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "princess-local",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "preview_database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "drizzle"
        }
    ],
    "env": {
        "production": {
            "name": "princess-stable",
            "workers_dev": false,
            "vars": {
                "BOT_ENVIRONMENT": "stable",
                "ENABLE_SCHEDULED_CLEANUP": "false",
                "AUTHOR_TWITTER_LINK": "https://twitter.com/giraffender",
                "WISHLIST_TG_URL": "https://t.me/wishlist_ua_bot",
                "CHATGPT_GITHUB_REPO_URL": "https://github.com/serhii-chernenko/chatgpt-telegram-bot",
                "TG_CHANNEL": "https://t.me/serhii_chernenko",
                "TG_GROUP": "https://t.me/serhii_chernenko_chat",
                "YT_CHANNEL": "https://youtube.com/@serhii.chernenko",
                "MAIL": "contact@chernenko.digital"
            },
            "secrets": {
                "required": [
                    "BOT_TOKEN",
                    "TELEGRAM_WEBHOOK_SECRET",
                    "TELEGRAM_WEBHOOK_PATH"
                ]
            },
            "routes": [
                {
                    "pattern": "princess.chernenko.dev",
                    "custom_domain": true
                }
            ],
            "triggers": {
                "crons": ["0 0 * * *"]
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "princess-production",
                    "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
                    "preview_database_id": "REPLACE_WITH_PRODUCTION_PREVIEW_DATABASE_ID",
                    "migrations_dir": "drizzle"
                }
            ]
        },
        "beta": {
            "name": "princess-beta",
            "workers_dev": false,
            "vars": {
                "BOT_ENVIRONMENT": "beta",
                "ENABLE_SCHEDULED_CLEANUP": "false",
                "AUTHOR_TWITTER_LINK": "https://twitter.com/giraffender",
                "WISHLIST_TG_URL": "https://t.me/wishlist_ua_bot",
                "CHATGPT_GITHUB_REPO_URL": "https://github.com/serhii-chernenko/chatgpt-telegram-bot",
                "TG_CHANNEL": "https://t.me/serhii_chernenko",
                "TG_GROUP": "https://t.me/serhii_chernenko_chat",
                "YT_CHANNEL": "https://youtube.com/@serhii.chernenko",
                "MAIL": "contact@chernenko.digital"
            },
            "secrets": {
                "required": [
                    "BOT_TOKEN",
                    "TELEGRAM_WEBHOOK_SECRET",
                    "TELEGRAM_WEBHOOK_PATH"
                ]
            },
            "routes": [
                {
                    "pattern": "princess-beta.chernenko.dev",
                    "custom_domain": true
                }
            ],
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "princess-beta",
                    "database_id": "REPLACE_WITH_BETA_DATABASE_ID",
                    "preview_database_id": "REPLACE_WITH_BETA_PREVIEW_DATABASE_ID",
                    "migrations_dir": "drizzle"
                }
            ]
        }
    }
}
