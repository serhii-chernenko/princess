{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "princess-local",
    "main": "src/worker/index.ts",
    "compatibility_date": "2026-05-09",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true
        },
        "traces": {
            "enabled": true,
            "head_sampling_rate": 0.05
        }
    },
    "vars": {
        "BOT_ENVIRONMENT": "local",
        "ENABLE_SCHEDULED_CLEANUP": "true",
        "ENABLE_RELEASE_BROADCAST": "false",
        "AUTHOR_TWITTER_LINK": "https://x.com/serhiichernenko",
        "WISHLIST_TG_URL": "https://t.me/wishlist_ua_bot",
        "CHATGPT_GITHUB_REPO_URL": "https://github.com/serhii-chernenko/chatgpt-telegram-bot",
        "TG_CHANNEL": "https://t.me/serhii_chernenko",
        "TG_GROUP": "https://t.me/serhii_chernenko_chat",
        "YT_CHANNEL": "https://youtube.com/@serhii.chernenko",
        "MAIL": "contact@chernenko.digital"
    },
    "secrets": {
        "required": [
            "BOT_TOKEN",
            "TELEGRAM_WEBHOOK_SECRET",
            "TELEGRAM_WEBHOOK_PATH"
        ]
    },
    "queues": {
        "producers": [
            {
                "binding": "RELEASE_QUEUE",
                "queue": "princess-local-release-announcements"
            }
        ]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "princess-local",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "preview_database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "drizzle"
        }
    ],
    "env": {
        "production": {
            "name": "princess",
            "workers_dev": false,
            "preview_urls": true,
            "vars": {
                "BOT_ENVIRONMENT": "production",
                "ENABLE_SCHEDULED_CLEANUP": "false",
                "ENABLE_RELEASE_BROADCAST": "true",
                "AUTHOR_TWITTER_LINK": "https://x.com/serhiichernenko",
                "WISHLIST_TG_URL": "https://t.me/wishlist_ua_bot",
                "CHATGPT_GITHUB_REPO_URL": "https://github.com/serhii-chernenko/chatgpt-telegram-bot",
                "TG_CHANNEL": "https://t.me/serhii_chernenko",
                "TG_GROUP": "https://t.me/serhii_chernenko_chat",
                "YT_CHANNEL": "https://youtube.com/@serhii.chernenko",
                "MAIL": "contact@chernenko.digital"
            },
            "secrets": {
                "required": [
                    "BOT_TOKEN",
                    "TELEGRAM_WEBHOOK_SECRET",
                    "TELEGRAM_WEBHOOK_PATH"
                ]
            },
            "routes": [
                {
                    "pattern": "princess.chernenko.dev",
                    "custom_domain": true
                }
            ],
            "triggers": {
                "crons": ["0 0 * * *", "*/10 * * * *"]
            },
            "queues": {
                "producers": [
                    {
                        "binding": "RELEASE_QUEUE",
                        "queue": "princess-release-announcements"
                    }
                ],
                "consumers": [
                    {
                        "queue": "princess-release-announcements",
                        "max_batch_size": 10,
                        "max_batch_timeout": 5,
                        "max_retries": 5,
                        "retry_delay": 30,
                        "max_concurrency": 1,
                        "dead_letter_queue": "princess-release-announcements-dlq"
                    }
                ]
            },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "princess-production",
                    "database_id": "19c5b5dd-ac9e-43ff-9a0a-40c77c39d1d1",
                    "migrations_dir": "drizzle"
                }
            ],
            "previews": {
                "vars": {
                    "BOT_ENVIRONMENT": "preview",
                    "ENABLE_SCHEDULED_CLEANUP": "false",
                    "ENABLE_RELEASE_BROADCAST": "false",
                    "AUTHOR_TWITTER_LINK": "https://x.com/serhiichernenko",
                    "WISHLIST_TG_URL": "https://t.me/wishlist_ua_bot",
                    "CHATGPT_GITHUB_REPO_URL": "https://github.com/serhii-chernenko/chatgpt-telegram-bot",
                    "TG_CHANNEL": "https://t.me/serhii_chernenko",
                    "TG_GROUP": "https://t.me/serhii_chernenko_chat",
                    "YT_CHANNEL": "https://youtube.com/@serhii.chernenko",
                    "MAIL": "contact@chernenko.digital"
                },
                "d1_databases": [
                    {
                        "binding": "DB",
                        "database_name": "princess-preview",
                        "database_id": "b9a13fb8-8745-4d33-a5a2-f067b7b35220",
                        "migrations_dir": "drizzle"
                    }
                ],
                "queues": {
                    "producers": [
                        {
                            "binding": "RELEASE_QUEUE",
                            "queue": "princess-preview-release-announcements"
                        }
                    ]
                },
                "observability": {
                    "enabled": true,
                    "logs": {
                        "enabled": true,
                        "head_sampling_rate": 1,
                        "invocation_logs": true
                    },
                    "traces": {
                        "enabled": true,
                        "head_sampling_rate": 0.05
                    }
                }
            }
        }
    }
}
