                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT count(*) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName LIKE 'release_announcement_%failed' FACET eventName LIMIT 10"
                            }
                        ]
                    }
                },
                {
