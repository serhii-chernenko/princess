                    "linkedEntityGuids": null,
                    "visualization": {
                        "id": "viz.bar"
                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT count(*) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND (outcome = 'error' OR eventName LIKE '%failed' OR eventName = 'telegram_update_lease_lost') FACET eventName LIMIT 20"
                            }
                        ]
                    }
                },
                {
