                    "visualization": {
                        "id": "viz.bar"
                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT count(*) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'telegram_webhook_completed' AND outcome = 'accepted' FACET commandCategory LIMIT 15"
                            }
                        ]
                    }
                },
                {
                    "title": "HTTP 5xx and request volume",
                    "layout": {
                        "column": 9,
                        "row": 19,
                        "width": 4,
                        "height": 3
                    },
                    "linkedEntityGuids": null,
                    "visualization": {
                        "id": "viz.line"
                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT count(*) AS 'All requests', filter(count(*), WHERE status >= 500) AS 'HTTP 5xx' FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'http_request_completed' TIMESERIES"
                            }
                        ]
                    }
                }
