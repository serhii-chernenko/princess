{
    "name": "Princess Bot — Production Observability",
    "description": "Production-only evlog telemetry from the Princess Cloudflare Worker. Ingest freshness, Telegram update health, scheduled work, releases and vote activity.",
    "permissions": "PUBLIC_READ_WRITE",
    "pages": [
        {
            "name": "Production",
            "description": "All widgets filter New Relic EU account 8569908 to the production Princess service.",
            "widgets": [
                {
                    "title": "Ingest: events in last 15 min",
                    "layout": {
                        "column": 1,
                        "row": 1,
                        "width": 4,
                        "height": 3
                    },
                    "linkedEntityGuids": null,
                    "visualization": {
                        "id": "viz.billboard"
                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT count(*) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' SINCE 15 minutes ago"
                            }
                        ]
                    }
                },
                {
                    "title": "Webhook failures in last hour",
                    "layout": {
                        "column": 5,
                        "row": 1,
                        "width": 4,
                        "height": 3
                    },
                    "linkedEntityGuids": null,
                    "visualization": {
                        "id": "viz.billboard"
                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT count(*) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'telegram_webhook_completed' AND outcome IN ('error', 'rejected') SINCE 1 hour ago"
                            }
                        ]
                    }
                },
                {
                    "title": "Webhook p95 latency (ms)",
                    "layout": {
                        "column": 9,
                        "row": 1,
                        "width": 4,
                        "height": 3
                    },
                    "linkedEntityGuids": null,
                    "visualization": {
                        "id": "viz.billboard"
                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT percentile(durationMs, 95) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'telegram_webhook_completed' SINCE 1 hour ago"
                            }
                        ]
                    }
                },
                {
