                            {
                                "accountIds": [8569908],
                                "query": "SELECT percentile(durationMs, 95) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'scheduled_run_completed' FACET cron TIMESERIES"
                            }
                        ]
                    }
                },
                {
                    "title": "Release broadcast coverage",
                    "layout": {
                        "column": 1,
                        "row": 16,
                        "width": 6,
                        "height": 3
                    },
                    "linkedEntityGuids": null,
                    "visualization": {
                        "id": "viz.table"
                    },
                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT latest(candidates) AS 'Candidate groups', latest(inserted) AS 'Created', latest(enqueued) AS 'Queued' FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'release_broadcast_completed' FACET releaseVersion LIMIT 10"
                            }
                        ]
                    }
                },
                {
                    "title": "Release queue failures",
                    "layout": {
