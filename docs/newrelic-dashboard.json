                    "rawConfiguration": {
                        "nrqlQueries": [
                            {
                                "accountIds": [8569908],
                                "query": "SELECT percentile(durationMs, 50, 95) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'telegram_webhook_completed' TIMESERIES"
                            }
