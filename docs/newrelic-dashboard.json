                            {
                                "accountIds": [8569908],
                                "query": "SELECT count(*) FROM Log_princess WHERE `service.name` = 'princess' AND botEnvironment = 'production' AND eventName = 'telegram_webhook_completed' FACET idempotencyOutcome LIMIT 10"
