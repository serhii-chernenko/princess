{
    "name": "princess",
    "version": "5.1.0",
    "description": "Randomly choose a princess of the day among group subscribers in Telegram",
    "main": "index.js",
    "author": "inevix",
    "license": "MIT",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "start": "pnpm run worker:dev",
        "dev": "pnpm run worker:dev",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:import:local": "tsx scripts/db/run-mongo-import.ts local",
        "db:import:prepare": "tsx scripts/db/prepare-mongo-import.ts",
        "db:import:prepare:github": "tsx scripts/db/prepare-mongo-import.ts --github-ref \"$MONGO_BACKUP_REF\"",
        "db:import:prod": "tsx scripts/db/run-mongo-import.ts production",
        "db:migrate:local": "tsx scripts/db/migrate-local.ts",
        "db:import:preview": "tsx scripts/db/run-mongo-import.ts preview",
        "db:migrate:prod": "tsx scripts/db/migrate-production.ts",
        "db:migrate:preview": "tsx scripts/db/migrate-preview.ts",
        "db:migrate:ci": "tsx scripts/db/migrate-ci.ts",
        "db:copy:production-to-preview": "tsx scripts/db/copy-production-to-preview.ts",
        "db:query:local": "wrangler d1 execute DB --local",
        "db:query:prod": "pnpm exec wrangler d1 execute DB --remote --env production",
        "db:query:preview": "pnpm exec wrangler d1 execute princess-preview --remote",
        "worker:dev": "tsx scripts/cloudflare/dev-with-tunnel.ts",
        "worker:dev:raw": "wrangler dev",
        "worker:dev:production": "wrangler dev --env production",
        "cloudflared:dev": "cloudflared tunnel --config cloudflared.yml run",
        "worker:preview": "wrangler preview --env production",
        "worker:deploy": "pnpm run worker:deploy:prod",
        "worker:deploy:prod": "tsx scripts/cloudflare/deploy-worker.ts production",
        "worker:tail:prod": "pnpm exec wrangler tail --env production",
        "telegram:webhook:set:local": "tsx scripts/telegram/webhook.ts set local",
        "telegram:webhook:info:local": "tsx scripts/telegram/webhook.ts info local",
        "telegram:webhook:delete:local": "tsx scripts/telegram/webhook.ts delete local",
        "telegram:webhook:set:prod": "tsx scripts/telegram/webhook.ts set production",
        "telegram:webhook:info:prod": "tsx scripts/telegram/webhook.ts info production",
        "telegram:webhook:delete:prod": "tsx scripts/telegram/webhook.ts delete production",
        "telegram:webhook:set:preview": "tsx scripts/telegram/webhook.ts set preview",
        "telegram:webhook:info:preview": "tsx scripts/telegram/webhook.ts info preview",
        "telegram:webhook:delete:preview": "tsx scripts/telegram/webhook.ts delete preview",
        "cf-typegen": "wrangler types",
        "i18n:generate": "typesafe-i18n --no-watch",
        "releases:sync": "tsx scripts/releases/sync-release-manifest.ts",
        "releases:github": "tsx scripts/releases/github-release.ts",
        "changeset:add": "changeset",
        "changeset:status": "changeset status",
        "releases:broadcast:prod": "tsx scripts/releases/trigger-broadcast.ts production",
        "changeset:validate": "tsx scripts/releases/validate-changesets.ts",
        "changeset:version": "pnpm run changeset:validate && changeset version && tsx scripts/releases/stamp-changelog.ts && pnpm run releases:sync && pnpm install --lockfile-only",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt . && oxlint . --fix && oxfmt .",
        "format:check": "oxfmt --check .",
        "typecheck": "pnpm run i18n:generate && tsgo -p tsconfig.json --noEmit",
        "test": "tsx --test \"test/**/*.test.ts\" \"test/**/*.test.cjs\"",
        "check": "pnpm run changeset:validate && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run releases:sync && pnpm test",
        "typesafe-i18n": "typesafe-i18n --no-watch"
    },
    "dependencies": {
        "dotenv": "^16.6.1",
        "drizzle-orm": "1.0.0-rc.1",
        "effect": "4.0.0-beta.58",
        "evlog": "2.24.0",
        "hono": "4.12.10",
        "telegraf": "^4.16.3",
        "typesafe-i18n": "^5.27.1"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@types/node": "^22.20.4",
        "@typescript/native-preview": "^7.0.0-dev.20260510.1",
        "drizzle-kit": "1.0.0-rc.1",
        "oxfmt": "^0.47.0",
        "oxlint": "^1.62.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "wrangler": "4.143.1"
    }
}
