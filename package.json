{
    "name": "princess",
    "version": "5.0.0",
    "description": "Randomly choose a princess of the day among group subscribers in Telegram",
    "main": "index.js",
    "author": "inevix",
    "license": "MIT",
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "start": "pnpm run worker:dev",
        "legacy:start": "NODE_ENV=production node bot/index.js",
        "dev": "pnpm run worker:dev",
        "legacy:dev": "NODE_ENV=dev nodemon bot/index.js",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:import:local": "tsx scripts/db/run-mongo-import.ts local",
        "db:import:prepare": "tsx scripts/db/prepare-mongo-import.ts",
        "db:import:prepare:github": "tsx scripts/db/prepare-mongo-import.ts --github-ref \"$MONGO_BACKUP_REF\"",
        "db:import:production": "tsx scripts/db/run-mongo-import.ts production",
        "db:import:beta": "tsx scripts/db/run-mongo-import.ts beta",
        "db:migrate:local": "tsx scripts/db/migrate-local.ts",
        "db:migrate:production": "tsx scripts/db/migrate-production.ts",
        "db:migrate:beta": "tsx scripts/db/migrate-beta.ts",
        "db:copy:production-to-beta": "tsx scripts/db/copy-production-to-beta.ts",
        "db:query:local": "wrangler d1 execute DB --local",
        "db:query:production": "pnpm exec wrangler d1 execute DB --remote --env production",
        "db:query:beta": "pnpm exec wrangler d1 execute DB --remote --env beta",
        "worker:dev": "tsx scripts/cloudflare/dev-with-tunnel.ts",
        "worker:dev:raw": "wrangler dev",
        "worker:dev:production": "wrangler dev --env production",
        "worker:dev:beta": "wrangler dev --env beta",
        "cloudflared:dev": "cloudflared tunnel --config cloudflared.yml run",
        "worker:deploy": "pnpm run worker:deploy:stable",
        "worker:deploy:stable": "tsx scripts/cloudflare/deploy-worker.ts production",
        "worker:deploy:production": "pnpm run worker:deploy:stable",
        "worker:deploy:beta": "tsx scripts/cloudflare/deploy-worker.ts beta",
        "worker:tail:stable": "pnpm exec wrangler tail --env production",
        "worker:tail:production": "pnpm run worker:tail:stable",
        "worker:tail:beta": "pnpm exec wrangler tail --env beta",
        "telegram:webhook:set:local": "tsx scripts/telegram/webhook.ts set local",
        "telegram:webhook:info:local": "tsx scripts/telegram/webhook.ts info local",
        "telegram:webhook:delete:local": "tsx scripts/telegram/webhook.ts delete local",
        "telegram:webhook:set:stable": "tsx scripts/telegram/webhook.ts set production",
        "telegram:webhook:info:stable": "tsx scripts/telegram/webhook.ts info production",
        "telegram:webhook:delete:stable": "tsx scripts/telegram/webhook.ts delete production",
        "telegram:webhook:set:production": "tsx scripts/telegram/webhook.ts set production",
        "telegram:webhook:info:production": "tsx scripts/telegram/webhook.ts info production",
        "telegram:webhook:delete:production": "tsx scripts/telegram/webhook.ts delete production",
        "telegram:webhook:set:beta": "tsx scripts/telegram/webhook.ts set beta",
        "telegram:webhook:info:beta": "tsx scripts/telegram/webhook.ts info beta",
        "telegram:webhook:delete:beta": "tsx scripts/telegram/webhook.ts delete beta",
        "cf-typegen": "wrangler types",
        "i18n:generate": "typesafe-i18n --no-watch",
        "releases:sync": "tsx scripts/releases/sync-release-manifest.ts",
        "changeset:add": "changeset",
        "changeset:status": "changeset status",
        "releases:broadcast:beta": "tsx scripts/releases/trigger-broadcast.ts beta",
        "releases:broadcast:stable": "tsx scripts/releases/trigger-broadcast.ts production",
        "changeset:validate": "tsx scripts/releases/validate-changesets.ts",
        "changeset:version": "pnpm run changeset:validate && changeset version && tsx scripts/releases/stamp-changelog.ts && pnpm run releases:sync && pnpm install --lockfile-only",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt . && oxlint . --fix && oxfmt .",
        "format:check": "oxfmt --check .",
        "typecheck": "pnpm run i18n:generate && tsgo -p tsconfig.json --noEmit",
        "typecheck:legacy": "tsc --noEmit",
        "test": "tsx --test \"test/**/*.test.ts\" \"test/**/*.test.cjs\"",
        "check": "pnpm run changeset:validate && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run releases:sync && pnpm test",
        "typesafe-i18n": "typesafe-i18n --no-watch"
    },
    "dependencies": {
        "dotenv": "^16.6.1",
        "drizzle-orm": "1.0.0-rc.1",
        "effect": "4.0.0-beta.58",
        "hono": "4.12.10",
        "mongoose": "^6.13.9",
        "telegraf": "^4.16.3",
        "typesafe-i18n": "^5.27.1"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "@typescript/native-preview": "^7.0.0-dev.20260510.1",
        "drizzle-kit": "1.0.0-rc.1",
        "nodemon": "^3.1.14",
        "oxfmt": "^0.47.0",
        "oxlint": "^1.62.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "wrangler": "4.90.0"
    }
}
