{
    "name": "princess",
    "version": "4.0.1",
    "description": "Randomly choose a princess of the day among group subscribers in Telegram",
    "main": "index.js",
    "author": "inevix",
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "start": "NODE_ENV=production node bot/index.js",
        "docker:start": "NODE_ENV=production docker compose -f .docker/compose.yaml up --force-recreate --build -d",
        "docker:stop": "NODE_ENV=production docker compose -f .docker/compose.yaml down",
        "docker:restart": "npm run docker:stop && npm run docker:start",
        "dev": "NODE_ENV=dev nodemon bot/index.js",
        "db:generate": "drizzle-kit generate --config drizzle.config.ts",
        "db:import:local": "npm run db:import:prepare && wrangler d1 execute DB --local --file=.backups/mongo-to-d1.sql",
        "db:import:prepare": "tsx scripts/db/prepare-mongo-import.ts",
        "db:import:production": "npm run db:import:prepare && wrangler d1 execute DB --remote --env production --file=.backups/mongo-to-d1.sql",
        "db:migrate:local": "tsx scripts/db/migrate-local.ts",
        "db:migrate:production": "DOTENV_CONFIG_PATH=.dev.vars.production drizzle-kit migrate --config drizzle.production.config.ts",
        "db:query:local": "wrangler d1 execute DB --local",
        "db:query:production": "wrangler d1 execute DB --remote --env production",
        "worker:dev": "wrangler dev",
        "worker:dev:production": "wrangler dev --env production",
        "worker:deploy": "npm run worker:deploy:production",
        "worker:deploy:production": "wrangler deploy --env production",
        "worker:types": "wrangler types",
        "docker:dev": "NODE_ENV=dev docker compose -f .docker/compose.yaml up --force-recreate --build",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "format": "oxlint . --fix && oxfmt .",
        "format:check": "oxfmt --check .",
        "typecheck": "npm run worker:types && tsc --noEmit",
        "test": "node --test",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
    },
    "dependencies": {
        "dotenv": "^16.6.1",
        "drizzle-orm": "1.0.0-rc.1",
        "effect": "4.0.0-beta.58",
        "hono": "4.12.10",
        "mongoose": "^6.13.9",
        "telegraf": "^4.16.3"
    },
    "devDependencies": {
        "drizzle-kit": "1.0.0-rc.1",
        "nodemon": "^3.1.14",
        "oxfmt": "^0.47.0",
        "oxlint": "^1.62.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "wrangler": "4.50.0"
    }
}
