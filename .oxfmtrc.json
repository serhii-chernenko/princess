{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "singleQuote": true,
    "jsxSingleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "none",
    "tabWidth": 4,
    "printWidth": 80,
    "sortPackageJson": false,
    "ignorePatterns": [
        "worker-configuration.d.ts",
        "releases.generated.json",
        "src/i18n/i18n-*.ts",
        ".agents/skills/**",
        "skills-lock.json"
    ]
}
