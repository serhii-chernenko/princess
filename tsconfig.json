{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "lib": ["ES2022"],
        "skipLibCheck": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "types/**/*.d.ts",
        "src/**/*.ts",
        "test/**/*.ts",
        "worker-configuration.d.ts"
    ]
}
